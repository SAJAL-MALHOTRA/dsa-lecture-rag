# Grounded-answer provider. The default URL is Groq's OpenAI-compatible API.
# Put a real key in your local environment; never commit it here.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Local alternative (example for Ollama):
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
